##########################################################################################
# Check Discard (use `-whyareyoukeeping <class_specification>` to debug)                 #
# https://developer.android.com/topic/performance/app-optimization/troubleshooting-rules #
##########################################################################################

# Check @Preview methods have been removed
-keepclassmembers,allowshrinking class * { @androidx.compose.ui.tooling.preview.Preview <methods>; }
-checkdiscard class * { @androidx.compose.ui.tooling.preview.Preview <methods>; }

# Check @TestOnly classes & methods have been removed, limited to this app's own code (because some libraries might incorrectly use this annotation)
-keep,allowshrinking @org.jetbrains.annotations.TestOnly class fr.smarquis.playground.* { *; }
-checkdiscard @org.jetbrains.annotations.TestOnly class fr.smarquis.playground.* { *; }
-keepclassmembers,allowshrinking class fr.smarquis.playground.* { @org.jetbrains.annotations.TestOnly <methods>; }
-checkdiscard class fr.smarquis.playground.* { @org.jetbrains.annotations.TestOnly <methods>; }
